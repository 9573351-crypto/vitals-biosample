+// Browser UI test double only. Native SQLite constraints are tested by DatabaseInstrumentation.
+(()=>{
+const read=()=>JSON.parse(localStorage.getItem('test-native')||'{"samples":{},"records":[],"settings":{},"revision":0,"nextId":1}');
