.local-ci/sqlite-check/*.db-journal
.local-ci/sqlite-check/*.db-wal
.local-ci/sqlite-check/*.db-shm
.local-ci/sqlite-check/*.sql.tmp
.local-ci/updater-check/out/
.local-ci/backup-format-check/out/
.local-ci/*.tmp
.local-ci/debug-*.mjs
.local-ci/instrument-*.txt
.local-ci/device-test.apk
.local-ci/commit-*.txt
*.zip
*.7z
*.rar

